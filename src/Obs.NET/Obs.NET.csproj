<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <!-- NuGet Package Configuration -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>Obs.NET</PackageId>
        <Title>Obs.NET - OBS Studio Integration Library</Title>
        <Description>A full-featured OBS Studio WebSocket v5 client library for .NET. Provides async/await API for controlling OBS Studio with 80+ request types, strongly-typed events, automatic reconnection, and SHA256 authentication support.</Description>
        <Authors>sid2934</Authors>
        <PackageTags>obs;obs-studio;websocket;obs-websocket;streaming;recording;video;broadcast</PackageTags>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/sid2934/Obs.NET</PackageProjectUrl>
        <RepositoryUrl>https://github.com/sid2934/Obs.NET</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <!-- SourceLink for debugging -->
    <PropertyGroup>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Generated\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All"/>
        <PackageReference Include="Nerdbank.GitVersioning">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>
